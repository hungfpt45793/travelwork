{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "ncjoes/poppler-php",
                "version": "1.1.1",
                "dist": {
                    "url": "https://api.github.com/repos/ncjoes/poppler-php/zipball/8c951b79dcb166cc4681c610b15bdb35653ff506",
                    "type": "zip"
                },
                "autoload": {
                    "psr-4": {
                        "NcJoes\\PopplerPhp\\": "src/PopplerPhp"
                    }
                },
                "require": {
                    "php": ">=5.5.9",
                    "illuminate/config": "^5.3|^6.0",
                    "illuminate/support": "^5.3|^6.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "anhskohbo/no-captcha": "^3.2",
        "arcanedev/log-viewer": "^5.2",
        "aws/aws-sdk-php": "^3.163",
        "barryvdh/laravel-dompdf": "^0.8.6",
        "convertio/convertio-php": "^0.4.0",
        "dompdf/dompdf": "^0.8.6",
        "facebook/graph-sdk": "^5.6",
        "google/apiclient": "^2.9",
        "google/recaptcha": "^1.2",
        "guzzlehttp/guzzle": "v6.5.5",
        "htmlmin/htmlmin": "^6.0",
        "ixudra/curl": "^6.16",
        "laravel/framework": "^6.20",
        "laravel/helpers": "^1.1",
        "laravel/socialite": "^4.4",
        "laravel/tinker": "~1.0",
        "mews/captcha": "^3.2",
        "ncjoes/poppler-php": "1.1.1",
        "phpoffice/phpspreadsheet": "^1.30",
        "phpoffice/phpword": "^1.2",
        "pusher/pusher-php-server": "v3.0.0",
        "renatomarinho/laravel-page-speed": "^1.8",
        "sendgrid/sendgrid": "~7",
        "setasign/fpdf": "1.8.*",
        "setasign/fpdi": "^2.0",
        "tinify/tinify": "^1.6",
        "twilio/sdk": "6.20",
        "tymon/jwt-auth": "^1.0.2",
        "uxweb/sweet-alert": "^2.0",
        "watson/sitemap": "^2.0",
        "webklex/laravel-pdfmerger": "^1.1",
        "yajra/laravel-datatables-oracle": "^9.18",
        "yangqi/htmldom": "1.0.*"
    },
    "require-dev": {
        "filp/whoops": "~2.0",
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "^1.3",
        "phpunit/phpunit": "^8.5"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
