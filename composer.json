{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "ncjoes/poppler-php",
                "version": "1.1.1",
                "dist": {
                    "url": "https://api.github.com/repos/ncjoes/poppler-php/zipball/8c951b79dcb166cc4681c610b15bdb35653ff506",
                    "type": "zip"
                },
                "autoload": {
                    "psr-4": {
                        "NcJoes\\PopplerPhp\\": "src/PopplerPhp"
                    }
                },
                "require": {
                    "php": ">=5.5.9",
                    "illuminate/config": "^5.3|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
                    "illuminate/support": "^5.3|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "facebook/graph-sdk",
                "version": "5.7.0",
                "dist": {
                    "url": "https://api.github.com/repos/facebook/php-graph-sdk/zipball/2d8250638b33d73e7a87add65f47fabf91f8ad9b",
                    "type": "zip"
                },
                "autoload": {
                    "psr-4": {
                        "Facebook\\": "src/Facebook/"
                    },
                    "files": [
                        "src/Facebook/polyfills.php"
                    ]
                },
                "require": {
                    "php": "^5.4|^7.0|^8.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "anhskohbo/no-captcha": "^3.2",
        "arcanedev/log-viewer": "^11.0",
        "aws/aws-sdk-php": "^3.163",
        "barryvdh/laravel-dompdf": "^3.1",
        "convertio/convertio-php": "^0.4.0",
        "dompdf/dompdf": "^3.1.6",
        "facebook/graph-sdk": "^5.6",
        "google/apiclient": "^2.9",
        "google/recaptcha": "^1.2",
        "guzzlehttp/guzzle": "^7.0.1",
        "ixudra/curl": "^6.16",
        "laravel/framework": "^11.56",
        "laravel/helpers": "^1.1",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.7.2",
        "laravel/ui": "^4.0",
        "mews/captcha": "^3.2",
        "ncjoes/poppler-php": "1.1.1",
        "nesbot/carbon": "^2.72",
        "phpoffice/phpspreadsheet": "^1.30",
        "phpoffice/phpword": "^1.2",
        "pusher/pusher-php-server": "^7.0",
        "renatomarinho/laravel-page-speed": "^4.4",
        "sendgrid/sendgrid": "~7",
        "setasign/fpdf": "1.8.*",
        "setasign/fpdi": "^2.0",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "tinify/tinify": "^1.6",
        "twilio/sdk": "6.20",
        "tymon/jwt-auth": "^2.3",
        "watson/sitemap": "^5.0",
        "webklex/laravel-pdfmerger": "^1.1",
        "yajra/laravel-datatables-oracle": "^11.0",
        "yangqi/htmldom": "1.0.*"
    },
    "require-dev": {
        "filp/whoops": "~2.0",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
